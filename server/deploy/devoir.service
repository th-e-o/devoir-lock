# systemd : sudo cp deploy/devoir.service /etc/systemd/system/ && sudo systemctl enable --now devoir
# Adapter User et WorkingDirectory.
[Unit]
Description=Devoir du jour (serveur)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/devoir-lock/server
EnvironmentFile=/home/pi/devoir-lock/server/.env
ExecStart=/home/pi/devoir-lock/server/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
