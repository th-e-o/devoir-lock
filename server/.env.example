# Copier en .env et remplir. Charger avec : set -a; . ./.env; set +a

# Clé API Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Jeton du bot Telegram (créé avec @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Identifiants des chats Telegram des professeurs (envoyer /start au bot pour obtenir le sien)
PROF_CHAT_IDS=
# Code d'accès de la page élève et du Raccourci (générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))")
DEVICE_TOKEN=
DEVICE_ID=telephone-eleve

DATA_DIR=./data
TIMEZONE=Europe/Paris
CLAUDE_MODEL=claude-opus-5-5
PROF_TIMEOUT_MINUTES=15
GENERATION_HOUR=5
# Le niveau et la durée visée se règlent dans l'interface professeur (/prof sur Telegram)
