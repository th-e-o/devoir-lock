# Copier en .env et remplir. Charger avec : set -a; . ./.env; set +a

# Clé API Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Jeton du bot Telegram (créé avec @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Identifiants des chats Telegram des parents (envoyer /start au bot pour obtenir le sien)
PARENT_CHAT_IDS=
# Code d'accès de la page élève et du Raccourci (générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))")
DEVICE_TOKEN=
DEVICE_ID=telephone-eleve

DATA_DIR=./data
TIMEZONE=Europe/Paris
CLAUDE_MODEL=claude-opus-5-5
PARENT_TIMEOUT_MINUTES=15
GENERATION_HOUR=5
TARGET_MINUTES=45
STUDENT_LEVEL=classe préparatoire scientifique (MPSI / MP2I, première année)
