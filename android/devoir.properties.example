# Copier en devoir.properties (ce fichier n'est pas versionné) et remplir.

# URL du serveur, vue depuis le téléphone (IP locale, nom Tailscale, ou domaine en HTTPS)
SERVER_URL=http://192.168.1.20:8000
# Même valeur que DEVICE_TOKEN côté serveur
DEVICE_TOKEN=change-moi
# Même valeur que DEVICE_ID côté serveur
DEVICE_ID=telephone-eleve
# Clé publique affichée par le serveur au démarrage (ou GET /api/public-key)
SERVER_PUBLIC_KEY=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE...
# Code parent pour l'écran d'administration (appui long sur le titre)
ADMIN_PIN=0000
# Paquets supplémentaires autorisés pendant le blocage, séparés par des virgules
# (le téléphone et l'appareil photo sont ajoutés automatiquement)
EXTRA_ALLOWED_PACKAGES=com.google.android.apps.messaging
